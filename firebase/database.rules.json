{
  "rules": {
    ".read": false,
    ".write": false,

    "users": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && (!data.exists() || !data.child('owner').exists() || data.child('owner').val() === auth.uid)",

        "owner": {
          ".validate": "newData.isString() && newData.val() === auth.uid"
        },
        "role": {
          ".validate": "newData.isString() && (newData.val() === 'senior' || newData.val() === 'guardian')"
        },
        "linkedTo": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 64"
        },
        "$other": { ".validate": false }
      }
    },

    "events": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && root.child('users').child($code).child('owner').val() === auth.uid",

        "$eventId": {
          ".validate": "newData.hasChildren(['timestamp', 'action', 'layer'])",

          "timestamp": { ".validate": "newData.isNumber()" },
          "appPackage": { ".validate": "newData.isString() && newData.val().length <= 128" },
          "adText": { ".validate": "newData.isString() && newData.val().length <= 200" },
          "action": {
            ".validate": "newData.isString() && (newData.val() === 'blocked' || newData.val() === 'warned' || newData.val() === 'ignored')"
          },
          "layer": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 3" },
          "$other": { ".validate": false }
        }
      }
    },

    "settings": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && root.child('users').child($code).child('owner').val() === auth.uid",

        "sensitivity": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1" },
        "whitelist": { ".validate": "newData.hasChildren() || newData.val() === null" },
        "$other": { ".validate": false }
      }
    }
  }
}
