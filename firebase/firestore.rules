rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // 기본은 전면 차단. 아래에서 명시적으로 연 것만 통과한다.
    match /{document=**} {
      allow read, write: if false;
    }

    // 가족 구성원인지. members 하위에 자기 uid 문서가 있으면 구성원이다.
    function isMember(familyId) {
      return request.auth != null &&
        exists(/databases/$(database)/documents/families/$(familyId)/members/$(request.auth.uid));
    }

    match /families/{familyId} {

      match /members/{uid} {
        // 구성원 목록은 구성원만 본다.
        allow read: if isMember(familyId);

        // 자기 문서만 쓴다. 남의 역할이나 FCM 토큰을 바꿀 수 없다.
        //
        // 첫 참여 때는 아직 구성원이 아니므로 isMember가 false다. 그래서
        // "자기 uid 문서를 처음 만드는 것"은 따로 허용한다 — 이게 없으면
        // 아무도 가족에 들어올 수 없다.
        allow create: if request.auth != null && request.auth.uid == uid;
        allow update, delete: if request.auth != null && request.auth.uid == uid;
      }

      match /settings/{uid} {
        allow read: if isMember(familyId);
        // 보호 강도는 보호자가 어르신 것을 바꿔야 하므로 구성원 누구나 쓸 수 있다.
        allow write: if isMember(familyId);
      }

      match /events/{eventId} {
        allow read: if isMember(familyId);
        // 기록은 남기기만 한다. 고치거나 지우면 보호자가 본 내역이 사라진다.
        allow create: if isMember(familyId);
        allow update, delete: if false;
      }

      match /reports/{month} {
        allow read: if isMember(familyId);
        allow write: if isMember(familyId);
      }
    }

    // 초대 코드 → familyId 역인덱스.
    //
    // 아직 가족이 아닌 사람이 읽어야 하므로 로그인만 요구한다. 여기 담긴 것은
    // familyId 하나뿐이라 노출돼도 가족 데이터에는 닿지 못한다 — 실제 접근은
    // 위의 isMember가 막는다.
    match /invites/{code} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null;
      allow delete: if false;
    }
  }
}
